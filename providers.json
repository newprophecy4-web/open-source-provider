    {
      "id": "peertube",
      "name": "PeerTube",
      "category": "video_platform",
      "enabled": true,
      "instance_required": true,
      "baseUrl": "https://INSTANCE",
      "apiBaseUrl": "https://INSTANCE/api/v1",
      "search": {
        "enabled": true,
        "method": "GET",
        "path": "/search/videos",
        "query": {
          "search": "{query}"
        }
      },
      "resolve": {
        "enabled": true,
        "method": "GET",
        "path": "/videos/{id}"
      },
      "playback": {
        "enabled": true,
        "types": ["hls", "web_video"],
        "directUrl": true
      },
      "subtitles": true,
      "authentication": {
        "required": false,
        "type": "none"
      },
      "rights": {
        "rehosting": false,
        "license": "video_specific"
      },
      "capabilities": {
        "metadata": true,
        "search": true,
        "resolve": true,
        "playback": true,
        "subtitles": true,
        "live": false
      },
      "response": {
        "resultsPath": "data",
        "mapping": {
          "id": ["id", "uuid"],
          "title": ["name", "title"],
          "originalTitle": ["originalTitle"],
          "url": ["url"],
          "thumbnail": ["thumbnailPath", "thumbnailUrl"],
          "duration": ["duration"],
          "language": ["language"],
          "license": ["licence.label"]
        }
      },
      "validation": {
        "requireTitle": true,
        "requireIdOrUrl": true,
        "discardEmptyResults": true
      }
    },

